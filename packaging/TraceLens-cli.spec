# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec file for TraceLens CLI (standalone onedir build)."""

import os
from PyInstaller.utils.hooks import copy_metadata

ROOT = os.path.abspath(os.path.join(SPECPATH, ".."))

